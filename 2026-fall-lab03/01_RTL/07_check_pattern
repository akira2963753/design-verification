echo -e "***********************************************************************"
echo -e "* Please make sure you include the encrypted design in your TESTBED.v *"
echo -e "***********************************************************************"
# Number of injected faults per specification, index 0 -> SPEC 4 ... index 5 -> SPEC 9.
# SPEC 10 (cascade order) has no injection of its own: an out-of-order level is a
# wrong value at that level, which SPEC 8 already covers.
#            SPEC   4 5 6 7  8 9
SPEC_CNT=(          4 5 2 1 10 2)
SPEC_ID=(           4 5 6 7  8 9)
./09_clean_up > check.log

for ((i=0; i<${#SPEC_ID[@]}; i++))
do
    n=${SPEC_ID[$i]}
    for((j=1; j<=${SPEC_CNT[$i]}; j++))
    do
        ./01_run_vcs_rtl SPEC_$n\_$j > check.log
        if  grep -i -q "SPEC-$n FAIL" 'vcs.log'; then
                echo -e "\033[32m--- SPEC-$n-$j check Pass ---\033[0m"
        else
                echo -e "\033[31m--- SPEC-$n-$j check Fail ---\033[0m"
                exit 0
        fi
    done
    echo -e "\033[42m--- PATTERN check SPEC-$n Pass ---\033[0m"
done

./01_run_vcs_rtl CORRECT > check.log
if  grep -i -q "Congratulations" 'vcs.log'; then
        echo -e "\033[32m--- CORRECT DESIGN check Pass ---\033[0m"
else
        echo -e "\033[31m--- CORRECT DESIGN check Fail ---\033[0m"
        exit 0
fi

echo -e "\033[42m--- PATTERN PASS !!! ---\033[0m"
